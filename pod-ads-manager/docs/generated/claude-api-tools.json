                          "$ref": "#/$defs/Currency"
                        }
                      },
                      "required": [
                        "amount_minor",
                        "currency"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "optimization_goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "billing_event": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "audience_ref": {
                  "$ref": "#/$defs/Id"
                },
                "start_time": {
                  "$ref": "#/$defs/Timestamp"
                },
                "end_time": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Timestamp"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schedule_timezone": {
                  "$ref": "#/$defs/Timezone"
                },
                "initial_status": {
                  "const": "PAUSED"
                }
              },
              "required": [
                "name",
                "daily_budget",
                "lifetime_budget",
                "optimization_goal",
                "billing_event",
                "audience_ref",
                "start_time",
                "end_time",
                "schedule_timezone",
                "initial_status"
              ]
            }
          },
          "required": [
            "action_id",
            "depends_on",
            "kind",
            "local_ref",
            "parent",
            "params"
          ]
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ActionCreateAdPaused": {
          "type": "object",
          "additionalProperties": false,
