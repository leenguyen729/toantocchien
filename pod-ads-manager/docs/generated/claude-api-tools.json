  {
    "name": "proposal__create",
    "description": "Tạo proposal (hoặc revision) từ action allowlist; backend tự tính hash, impact, policy. Không thực thi.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ad_account_id": {
          "$ref": "#/$defs/Id"
        },
        "proposal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "rollback_plan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_snapshot_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      },
      "required": [
        "ad_account_id",
        "proposal_id",
        "actions",
        "reason",
        "rollback_plan",
        "source_snapshot_ids"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        },
        "NonNegMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "Currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 alpha code"
        },
        "ActionCreateCampaignPaused": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "depends_on": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "uniqueItems": true
            },
            "kind": {
              "const": "CREATE_CAMPAIGN_PAUSED"
            },
            "local_ref": {
              "$ref": "#/$defs/Id"
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "objective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "Validated against capability snapshot, not hard-coded"
                },
                "daily_budget": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "amount_minor": {
                          "$ref": "#/$defs/NonNegMinor"
                        },
                        "currency": {
                          "$ref": "#/$defs/Currency"
                        }
                      },
                      "required": [
                        "amount_minor",
                        "currency"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "initial_status": {
                  "const": "PAUSED"
                }
              },
              "required": [
                "name",
                "objective",
                "daily_budget",
                "initial_status"
              ]
            }
          },
          "required": [
            "action_id",
            "depends_on",
            "kind",
            "local_ref",
            "params"
          ]
        },
        "Timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC"
        },
        "Timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+\\-]+)*$",
          "description": "IANA timezone, verified in code"
        },
        "ActionCreateAdsetPaused": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "$ref": "#/$defs/Id"
            },
            "depends_on": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Id"
              },
              "uniqueItems": true
            },
            "kind": {
              "const": "CREATE_ADSET_PAUSED"
            },
            "local_ref": {
              "$ref": "#/$defs/Id"
            },
            "parent": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "local_ref": {
                      "$ref": "#/$defs/Id"
                    }
                  },
                  "required": [
                    "local_ref"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "entity_id": {
                      "$ref": "#/$defs/Id"
                    }
                  },
                  "required": [
                    "entity_id"
                  ]
                }
              ]
            },
            "params": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
