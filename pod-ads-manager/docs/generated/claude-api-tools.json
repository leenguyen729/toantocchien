  {
    "name": "proposal__validate",
    "description": "Chạy lại policy với trạng thái hiện tại; không đổi gì.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "proposal_id",
        "revision"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        }
      }
    }
  },
  {
    "name": "approval__status",
    "description": "Trạng thái approval của một revision (none/approved/rejected/expired). Không thể duyệt qua tool này.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "proposal_id",
        "revision"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        }
      }
    }
  },
  {
    "name": "execution__request",
    "description": "Xin xếp hàng thực thi proposal ĐÃ được người duyệt. Chỉ nhận proposal_id/revision/expected_payload_hash.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "expected_payload_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "proposal_id",
        "revision",
        "expected_payload_hash"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        },
        "Sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  {
    "name": "execution__reconcile",
    "description": "Đối soát proposal UNKNOWN với remote (read-only, không tạo lại).",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/Id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "proposal_id",
        "revision"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        }
      }
    }
  },
  {
    "name": "ops__health",
    "description": "Sức khỏe hệ thống: mode, freeze, hàng đợi, UNKNOWN, incident, chuỗi audit.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    }
  },
  {
    "name": "ops__freeze_writes",
    "description": "Bật khóa ghi nội bộ (fail-closed). KHÔNG dừng quảng cáo đang chạy. Mở lại chỉ owner trên UI.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "reason"
      ]
    }
  },
  {
    "name": "ops__incident__create",
    "description": "Tạo incident từ tín hiệu, tùy chọn khóa ghi nội bộ.",
    "input_schema": {
      "$ref": "#/$defs/OperationsIncidentInput",
      "$defs": {
        "Timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC"
        },
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        },
        "OperationsIncidentInput": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "signal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "connector_error",
                    "data_stale",
                    "permission_lost",
                    "spend_anomaly",
                    "unknown_mutation",
                    "audit_unavailable",
                    "other"
                  ]
                },
                "detail": {
                  "type": "string",
                  "maxLength": 1000
                },
                "observed_at": {
                  "$ref": "#/$defs/Timestamp"
                },
                "ad_account_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Id"
                  }
                }
              },
              "required": [
                "kind",
                "detail",
                "observed_at",
                "ad_account_ids"
              ]
            },
            "request_freeze": {
              "type": "boolean"
            }
          },
          "required": [
            "signal",
            "request_freeze"
          ]
        }
      }
    }
  },
  {
    "name": "ops__recovery__draft",
    "description": "Checklist khôi phục xác định theo loại tín hiệu.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "connector_error",
            "data_stale",
            "permission_lost",
            "spend_anomaly",
            "unknown_mutation",
            "audit_unavailable",
            "other"
          ]
        }
      },
      "required": [
        "kind"
      ]
    }
  }
