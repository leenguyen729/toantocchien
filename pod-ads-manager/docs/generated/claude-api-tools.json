[
  {
    "name": "context__get",
    "description": "Đọc BusinessConfig mới nhất của ad account.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ad_account_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "ad_account_id"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        }
      }
    }
  },
  {
    "name": "context__validate",
    "description": "Kiểm tra config nháp: currency/timezone/caps/FX; trả readiness và missing_fields. Không lưu.",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "config_draft": {
          "$ref": "#/$defs/BusinessConfig"
        }
      },
      "required": [
        "config_draft"
      ],
      "$defs": {
        "Id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:\\-]*$",
          "description": "Opaque identifier"
        },
        "Country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "Currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 alpha code"
        },
        "Timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+\\-]+)*$",
          "description": "IANA timezone, verified in code"
        },
        "NonNegMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "Timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "RFC3339 UTC"
        },
        "BusinessConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant_id": {
              "$ref": "#/$defs/Id"
            },
            "store_id": {
              "$ref": "#/$defs/Id"
            },
            "ad_account_id": {
              "$ref": "#/$defs/Id"
            },
            "markets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "country": {
                    "$ref": "#/$defs/Country"
                  },
                  "currency": {
                    "$ref": "#/$defs/Currency"
                  }
                },
                "required": [
                  "country",
                  "currency"
                ]
              },
              "minItems": 0
            },
            "account_currency": {
              "$ref": "#/$defs/Currency"
            },
            "store_currency": {
              "$ref": "#/$defs/Currency"
            },
            "reporting_timezone": {
              "$ref": "#/$defs/Timezone"
            },
            "account_timezone": {
              "$ref": "#/$defs/Timezone"
            },
            "kpi": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primary": {
                  "type": "string",
                  "enum": [
                    "contribution_after_ads",
                    "cpa",
                    "roas",
                    "mer"
                  ]
                },
                "target_cpa_minor": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NonNegMinor"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "target_roas": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "primary",
                "target_cpa_minor",
                "target_roas"
              ]
            },
            "caps": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "daily_budget_cap_minor": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NonNegMinor"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lifetime_budget_cap_minor": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NonNegMinor"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "proposal_exposure_cap_minor": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/NonNegMinor"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "daily_budget_cap_minor",
                "lifetime_budget_cap_minor",
                "proposal_exposure_cap_minor"
              ]
            },
            "max_change_pct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_change_amount_minor": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NonNegMinor"
                },
                {
                  "type": "null"
                }
              ]
            },
            "freshness_seconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "cooldown_seconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "approval_ttl_seconds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 86400
                },
                {
                  "type": "null"
                }
              ]
            },
            "separation_of_duties": {
              "type": "boolean"
            },
            "fx": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "method": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 200
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "source",
                "method"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "confirmed"
              ]
            },
            "confirmed_by": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confirmed_at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "required": [
            "tenant_id",
            "store_id",
            "ad_account_id",
            "markets",
            "account_currency",
            "store_currency",
            "reporting_timezone",
            "account_timezone",
            "kpi",
            "caps",
            "max_change_pct",
            "max_change_amount_minor",
            "freshness_seconds",
            "cooldown_seconds",
            "approval_ttl_seconds",
            "separation_of_duties",
            "fx",
            "version",
            "status",
            "confirmed_by",
            "confirmed_at",
            "updated_at"
          ]
        }
      }
    }
  },
