    {
      "id": "s17-kill-switch-holds-queued-job",
      "category": "specific",
      "critical": true,
      "description": "Job đã xếp hàng, operator bật kill switch: worker không gửi gì, proposal vẫn QUEUED.",
      "steps": [
        {
          "as": "claude",
          "tool": "proposal.create",
          "input": {
            "ad_account_id": "act_demo",
