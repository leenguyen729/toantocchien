          "input": {
            "reason": "nghi spend bất thường"
          },
          "expect": [
            {
              "path": "data.freeze_state.frozen",
              "equals": true
            }
          ]
        },
        {
          "do": "drain"
        }
      ],
      "final": {
        "outbound_writes": 0,
        "frozen": true,
        "proposal": {
          "ref": "p",
          "status": "QUEUED"
        }
      }
    }
