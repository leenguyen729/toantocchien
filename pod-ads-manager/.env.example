# POD AI Facebook Ads Manager — ví dụ cấu hình. CHỈ placeholder, không có secret.
# Mặc định an toàn: mock, không ghi thật. Không tự đổi hai dòng dưới khi chưa có authorization cụ thể.
EXECUTION_MODE=mock
LIVE_WRITES_ENABLED=false

# Chỉ dùng khi EXECUTION_MODE=approval và LIVE_WRITES_ENABLED=true (operator cấu hình, không phải dev).
META_ACCOUNT_ALLOWLIST=

# Khóa ký approval (hex >= 32 bytes) lấy từ vault. Mock mode tự sinh khóa tạm nếu bỏ trống.
APPROVAL_SIGNING_KEY=
APPROVAL_SIGNING_KEY_ID=k1

# Postgres (tùy chọn). Bỏ trống = demo in-memory.
DATABASE_URL=
SEED_DEMO=true

API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Live adapters chưa nghiệm thu (P2+). Token KHÔNG đặt ở đây trong production: dùng vault.
META_ACCESS_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
